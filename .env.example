# Cấu hình gửi email cho form "Liên hệ hợp tác doanh nghiệp".
# Sao chép file này thành `.env.local` rồi điền giá trị thật. KHÔNG commit `.env.local`.
#
# Dùng Gmail: bật xác minh 2 bước cho tài khoản, rồi tạo "Mật khẩu ứng dụng"
# (App password) tại https://myaccount.google.com/apppasswords và dán vào SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=caitieminao@gmail.com
SMTP_PASS=

# Hộp thư nhận yêu cầu. Bỏ trống thì gửi về email trong src/lib/content.ts.
CONTACT_TO=
